{
  "name": "Bandolibre Software Update",
  "short_name": "BandoUpdate",
  "description": "Firmware update tool for Bandolibre, the open-source digital Argentine bandoneon. Updates the instrument over USB-MIDI from the browser.",
  "id": "/bandolibre/update/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f7f8",
  "theme_color": "#2f7d78",
  "orientation": "any",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
