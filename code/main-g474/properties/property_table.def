/* Single source of truth for the global property system.
 *
 * No header guard: this file is #included repeatedly, each time with a
 * different PROPERTY() definition, to generate the live-value struct, the
 * descriptor table and the compile-time tag check.
 *
 * PROPERTY(tag, type, name, <named metadata...>)
 *   tag             permanent blob identity used by the persistence layer.
 *                   NEVER reuse a tag, even after a property is removed.
 *                   0 (PROPERTY_TAG_NONE) marks a transient (non-persistent) property.
 *   type            C type of the value: uint16_t or bool
 *   name            struct member (direct read g_properties->name) and, stringized,
 *                   the lookup name
 *   .default_value  initial value and the value property_reset() restores
 *                   (bool: 0/1). Named .default would clash with the C keyword.
 *   .min .max       inclusive bounds; set() clamps, flash load defaults on
 *                   violation. Omit for bool (range is implicitly 0..1).
 *   .description    human-readable text for the editor
 */

PROPERTY(1, uint16_t, key_press,
         .default_value = 1900, .min = 0, .max = 4095,
         .description = "ADC below this -> key pressed")
PROPERTY(2, uint16_t, key_release,
         .default_value = 2100, .min = 0, .max = 4095,
         .description = "ADC above this -> key released")

/* Bellows programs: FN1 cycles bellow_program through BELLOW_PROGRAM_COUNT
 * (bellow.h) sets of center, dead zone, full travel and response curves, each
 * BELLOW_PROGRAM() being 12 consecutive tags from tag0:
 *   BELLOW_PROGRAM(n, tag0, full_push, (x1, y1), (x2, y2),
 *                           full_pull, (x1, y1), (x2, y2))
 * where each (x, y) is a cubic-Bezier control point default, /256. */
#define BELLOW_CP_X(x, y) x
#define BELLOW_CP_Y(x, y) y
#define BELLOW_PROGRAM(n, tag0, full_push_default, push_p1, push_p2, \
                       full_pull_default, pull_p1, pull_p2) \
PROPERTY(tag0 + 0, uint16_t, bellow_p##n##_center, \
         .default_value = 28972, .min = 17000, .max = 34000, \
         .description = "Program " #n ": combined hall reading at rest (measured on hardware at ADC oversampling RightBitShift_5)") \
PROPERTY(tag0 + 1, uint16_t, bellow_p##n##_dead, \
         .default_value = 64, .min = 0, .max = 4095, \
         .description = "Program " #n ": travel each way before registering direction; entry threshold is dead/2 + hyst/2 from center") \
PROPERTY(tag0 + 2, uint16_t, bellow_p##n##_full_push, \
         .default_value = full_push_default, .min = 0, .max = 50000, \
         .description = "Program " #n ": combined hall reading at full push") \
PROPERTY(tag0 + 3, uint16_t, bellow_p##n##_full_pull, \
         .default_value = full_pull_default, .min = 0, .max = 50000, \
         .description = "Program " #n ": combined hall reading at full pull") \
PROPERTY(tag0 + 4, uint16_t, bellow_p##n##_push_curve_x1, \
         .default_value = BELLOW_CP_X push_p1, .min = 0, .max = 256, \
         .description = "Program " #n ": push curve, control point 1 X (near center), cubic Bezier /256") \
PROPERTY(tag0 + 5, uint16_t, bellow_p##n##_push_curve_y1, \
         .default_value = BELLOW_CP_Y push_p1, .min = 0, .max = 256, \
         .description = "Program " #n ": push curve, control point 1 Y (near center), cubic Bezier /256") \
PROPERTY(tag0 + 6, uint16_t, bellow_p##n##_push_curve_x2, \
         .default_value = BELLOW_CP_X push_p2, .min = 0, .max = 256, \
         .description = "Program " #n ": push curve, control point 2 X (near full travel), cubic Bezier /256") \
PROPERTY(tag0 + 7, uint16_t, bellow_p##n##_push_curve_y2, \
         .default_value = BELLOW_CP_Y push_p2, .min = 0, .max = 256, \
         .description = "Program " #n ": push curve, control point 2 Y (near full travel), cubic Bezier /256") \
PROPERTY(tag0 + 8, uint16_t, bellow_p##n##_pull_curve_x1, \
         .default_value = BELLOW_CP_X pull_p1, .min = 0, .max = 256, \
         .description = "Program " #n ": pull curve, control point 1 X (near center), cubic Bezier /256") \
PROPERTY(tag0 + 9, uint16_t, bellow_p##n##_pull_curve_y1, \
         .default_value = BELLOW_CP_Y pull_p1, .min = 0, .max = 256, \
         .description = "Program " #n ": pull curve, control point 1 Y (near center), cubic Bezier /256") \
PROPERTY(tag0 + 10, uint16_t, bellow_p##n##_pull_curve_x2, \
         .default_value = BELLOW_CP_X pull_p2, .min = 0, .max = 256, \
         .description = "Program " #n ": pull curve, control point 2 X (near full travel), cubic Bezier /256") \
PROPERTY(tag0 + 11, uint16_t, bellow_p##n##_pull_curve_y2, \
         .default_value = BELLOW_CP_Y pull_p2, .min = 0, .max = 256, \
         .description = "Program " #n ": pull curve, control point 2 Y (near full travel), cubic Bezier /256")

/* p0 is the nominal travel; p1 and p2 reach full expression with 1/1.5 and
 * 1/2 of it, like the former x1.5 and x2.0 sensitivity levels. */
BELLOW_PROGRAM(0, 3,  25849, (10, 0), (245, 256), 32000, (10, 0), (245, 256))
BELLOW_PROGRAM(1, 15, 26890, (10, 0), (245, 256), 30991, (10, 0), (245, 256))
BELLOW_PROGRAM(2, 27, 27410, (10, 0), (245, 256), 30486, (10, 0), (245, 256))
#undef BELLOW_PROGRAM
#undef BELLOW_CP_X
#undef BELLOW_CP_Y
PROPERTY(39, uint16_t, bellow_program,
         .default_value = 0, .min = 0, .max = 2,
         .description = "Active bellows program (bellow_p<n>_*), 0..BELLOW_PROGRAM_COUNT-1; also advanced by the FN1 button")

PROPERTY(40, uint16_t, bellow_hyst,
         .default_value = 12, .min = 0, .max = 4095,
         .description = "Margin given back before returning to neutral")
PROPERTY(41, uint16_t, bellow_cc_period_ms,
         .default_value = 5, .min = 1, .max = 1000,
         .description = "Min milliseconds between expression-CC sends")
PROPERTY(42, uint16_t, bellow_settle_us,
         .default_value = 2, .min = 0, .max = 1000,
         .description = "Hall supply settling delay before sampling, microseconds")
PROPERTY(43, uint16_t, bellow_sample_period_us,
         .default_value = 250, .min = 250, .max = 10000,
         .description = "Min microseconds between hall-sensor samples (caps sampling at 4kHz; sampling faster wastes CPU with no usable signal above it)")
PROPERTY(44, uint16_t, bellow_cc_1e_mincutoff,
         .default_value = 16, .min = 26, .max = 2560,
         .description = "1-euro filter cutoff at rest, Hz/256 (256=1.0Hz); Lower smooths more at rest. See one_euro_filter.h")
PROPERTY(45, uint16_t, bellow_cc_1e_beta,
         .default_value = 20, .min = 0, .max = 65535,
         .description = "1-euro filter speed coefficient /65536 (459~=0.007); Higher tracks fast moves with less lag")
PROPERTY(46, uint16_t, midi_active_sensing_period,
         .default_value = 200, .min = 10, .max = 300,
         .description = "Milliseconds between MIDI Active Sensing bytes")
PROPERTY(47, bool, midi_active_sensing_enable,
         .default_value = 1,
         .description = "Send MIDI Active Sensing (0xFE) periodically")
PROPERTY(48, uint16_t, pedal1_min,
         .default_value = 920, .min = 0, .max = 4095,
         .description = "Pedal 1 (expression) ADC at minimum -> CC 0")
PROPERTY(49, uint16_t, pedal1_max,
         .default_value = 3100, .min = 0, .max = 4095,
         .description = "Pedal 1 (expression) ADC at maximum -> CC 127")
PROPERTY(50, uint16_t, pedal2_min,
         .default_value = 920, .min = 0, .max = 4095,
         .description = "Pedal 2 (sustain) ADC at minimum -> CC 0")
PROPERTY(51, uint16_t, pedal2_max,
         .default_value = 3100, .min = 0, .max = 4095,
         .description = "Pedal 2 (sustain) ADC at maximum -> CC 127")
PROPERTY(52, uint16_t, pedal1_hyst_fwd,
         .default_value = 4, .min = 0, .max = 4095,
         .description = "Pedal 1 forward play (raw units) before advance; 0 with pedal1_hyst_rev=0 disables this backlash entirely")
PROPERTY(53, uint16_t, pedal1_hyst_rev,
         .default_value = 16, .min = 0, .max = 4095,
         .description = "Pedal 1 reverse play (raw units) before direction flips")
PROPERTY(54, uint16_t, pedal1_cc_period_ms,
         .default_value = 10, .min = 1, .max = 1000,
         .description = "Pedal 1 min milliseconds between CC sends")
PROPERTY(55, uint16_t, pedal2_hyst_fwd,
         .default_value = 4, .min = 0, .max = 4095,
         .description = "Pedal 2 forward play (raw units) before advance; 0 with pedal2_hyst_rev=0 disables this backlash entirely")
PROPERTY(56, uint16_t, pedal2_hyst_rev,
         .default_value = 16, .min = 0, .max = 4095,
         .description = "Pedal 2 reverse play (raw units) before direction flips")
PROPERTY(57, uint16_t, pedal2_cc_period_ms,
         .default_value = 10, .min = 1, .max = 1000,
         .description = "Pedal 2 min milliseconds between CC sends")
PROPERTY(58, uint16_t, tablemode_velocity,
         .default_value = 80, .min = 1, .max = 127,
         .description = "CC#11 and velocity value sent in table mode")
PROPERTY(59, uint16_t, keyboard_tuning,
         .default_value = 0, .min = 0, .max = 2,
         .description = "Note layout: 0 Rheinische (bisonoric), 1 Peguri, 2 Manoury (unisonoric)")
PROPERTY(PROPERTY_TAG_NONE, bool, log_bellow,
         .default_value = 0,
         .description = "Log hall readings and bellows direction each poll")
PROPERTY(PROPERTY_TAG_NONE, bool, log_spi_stat,
         .default_value = 0,
         .description = "Log SPI link error and reception-rate statistics")
PROPERTY(PROPERTY_TAG_NONE, bool, log_pedals,
         .default_value = 0,
         .description = "Log pedal presence changes and wiper movement each poll")
PROPERTY(PROPERTY_TAG_NONE, bool, log_midi_sysex,
         .default_value = 0,
         .description = "Log incoming/outgoing MIDI sysex frames on the console")
PROPERTY(PROPERTY_TAG_NONE, uint16_t, report_hz,
         .default_value = 4, .min = 1, .max = 30,
         .description = "Live-report dashboard refresh rate in Hz")
PROPERTY(PROPERTY_TAG_NONE, bool, show_bellow,
         .default_value = 1,
         .description = "Live-report the bellows direction, intensity and hall readings")
PROPERTY(PROPERTY_TAG_NONE, bool, show_spi,
         .default_value = 0,
         .description = "Live-report the per-wing SPI link reception counters and rates")
PROPERTY(PROPERTY_TAG_NONE, uint16_t, show_keyboard,
         .default_value = 0, .min = 0, .max = 3,
         .description = "Live-report wing keyboards: 0 off, 1 left, 2 right, 3 both")
PROPERTY(PROPERTY_TAG_NONE, uint16_t, show_keyboard_stats,
         .default_value = 0, .min = 0, .max = 3,
         .description = "Add min/max/diff/stddev tables: 0 off, 1 left, 2 right, 3 both")
PROPERTY(PROPERTY_TAG_NONE, bool, table_mode,
         .default_value = 0,
         .description = "Bellows direction pinned to PULL so keys sound at rest on a table; also toggled by the FN0 button")
PROPERTY(60, uint16_t, pedal1_1e_mincutoff,
         .default_value = 256, .min = 26, .max = 2560,
         .description = "Pedal 1 1-euro filter cutoff at rest, Hz /256 (256=1.0Hz); lower smooths more at rest")
PROPERTY(61, uint16_t, pedal1_1e_beta,
         .default_value = 459, .min = 0, .max = 65535,
         .description = "Pedal 1 1-euro filter speed coefficient /65536 (459~=0.007); higher tracks fast moves with less lag")
PROPERTY(62, uint16_t, pedal2_1e_mincutoff,
         .default_value = 256, .min = 26, .max = 2560,
         .description = "Pedal 2 1-euro filter cutoff at rest, Hz /256 (256=1.0Hz); lower smooths more at rest")
PROPERTY(63, uint16_t, pedal2_1e_beta,
         .default_value = 459, .min = 0, .max = 65535,
         .description = "Pedal 2 1-euro filter speed coefficient /65536 (459~=0.007); higher tracks fast moves with less lag")
