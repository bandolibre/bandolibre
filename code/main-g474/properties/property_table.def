/* Note-on velocity source and key strike. velocity_source 0 sends the bellows
 * intensity (the original behaviour); 1 sends the speed at which the key
 * crossed from strike_start down to key_press (app/key_strike.h), mapped
 * linearly between strike_speed_min and strike_speed_max, shaped by a Bezier
 * curve (the same 0..255 control points as the bellows curves) and scaled to
 * strike_vel_min..strike_vel_max. The factory strike values are first guesses,
 * to be tuned on hardware. A synth holding the velocity lease (bandopm,
 * SYSEX_MSG_VELOCITY_LEASE) sets this to 1 while it holds it, and the
 * previous value comes back when the lease lapses. */
PROPERTY(62, uint16_t, velocity_source,
         .factory_value = 0, .min = 0, .max = 1,
         .description = "Note velocity from: 0 bellows, 1 key speed")
PROPERTY(63, uint16_t, strike_start,
         .factory_value = 2400, .min = 0, .max = 4095,
         .description = "Strike speed is timed from this ADC level to key_press")
PROPERTY(64, uint16_t, strike_speed_min,
         .factory_value = 50, .min = 0, .max = 65535,
         .description = "Strike speed mapped to the minimum velocity, ADC counts per 10 ms")
PROPERTY(65, uint16_t, strike_speed_max,
         .factory_value = 1500, .min = 1, .max = 65535,
         .description = "Strike speed mapped to the maximum velocity, ADC counts per 10 ms")
PROPERTY(66, uint16_t, strike_vel_min,
         .factory_value = 20, .min = 1, .max = 127,
         .description = "Velocity of the slowest strike")
PROPERTY(67, uint16_t, strike_vel_max,
         .factory_value = 127, .min = 1, .max = 127,
         .description = "Velocity of the fastest strike")
PROPERTY(68, property_point_t, strike_curve_p1,
         .factory_value = PROPERTY_POINT(102, 0),
         .description = "Strike curve control point near the slowest, x,y 0..255")
PROPERTY(69, property_point_t, strike_curve_p2,
         .factory_value = PROPERTY_POINT(153, 255),
         .description = "Strike curve control point near the fastest, x,y 0..255")
PROPERTY(70, bool, strike_log,
         .factory_value = 0,
         .description = "Map the logarithm of the strike speed instead of the speed")
PROPERTY(71, uint16_t, deferred_velocity,
         .factory_value = 40, .min = 1, .max = 127,
         .description = "Velocity of a key already held when the bellows starts moving")

/* Note-off velocity, with velocity_source 1: the speed at which the key rose
 * from key_press back to key_release (app/key_strike.h), mapped like the
 * strike by its own release_* range, curve and velocities. A note silenced by
 * the bellows reaching neutral (key still held) sends release_neutral_velocity.
 * Every other note off (velocity_source 0, table mode, a keyboard link lost)
 * sends 64, the MIDI value for "release velocity not measured". The factory
 * release values are first guesses (a linear curve), to be tuned on hardware. */
PROPERTY(72, uint16_t, release_speed_min,
         .factory_value = 20, .min = 0, .max = 65535,
         .description = "Release speed mapped to the minimum velocity, ADC counts per 10 ms")
PROPERTY(73, uint16_t, release_speed_max,
         .factory_value = 800, .min = 1, .max = 65535,
         .description = "Release speed mapped to the maximum velocity, ADC counts per 10 ms")
PROPERTY(74, uint16_t, release_vel_min,
         .factory_value = 20, .min = 1, .max = 127,
         .description = "Note-off velocity of the slowest release")
PROPERTY(75, uint16_t, release_vel_max,
         .factory_value = 127, .min = 1, .max = 127,
         .description = "Note-off velocity of the fastest release")
PROPERTY(76, property_point_t, release_curve_p1,
         .factory_value = PROPERTY_POINT(85, 85),
         .description = "Release curve control point near the slowest, x,y 0..255")
PROPERTY(77, property_point_t, release_curve_p2,
         .factory_value = PROPERTY_POINT(170, 170),
         .description = "Release curve control point near the fastest, x,y 0..255")
PROPERTY(78, bool, release_log,
         .factory_value = 0,
         .description = "Map the logarithm of the release speed instead of the speed")
PROPERTY(79, uint16_t, release_neutral_velocity,
         .factory_value = 64, .min = 1, .max = 127,
         .description = "Note-off velocity of a note silenced by the bellows reaching neutral")
