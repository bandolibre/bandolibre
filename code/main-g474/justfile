import '../common/board.just'
set fallback

# The release's major and minor version, for the .uf2 name: bandolibre-v1.2-alpha-… -> v1_2.
uf2_version := `git describe --tags --match 'bandolibre-v*' --abbrev=0 2>/dev/null | sed -nE 's/^bandolibre-v([0-9]+)\.([0-9]+).*/v\1_\2/p' | grep . || echo vunknown`

# Keep first: a bare `just` runs the first recipe of this file (see board.just).

# Show the available recipes.
default: _list

# Build and run host unit tests for HAL-free modules (e.g. properties)
test:
    cmake -S host_tests -B build/host_tests
    cmake --build build/host_tests
    ctest --test-dir build/host_tests --output-on-failure

# Flash the Debug build over SWD, above the bootloader (install that once with `cd ../boot-g474 && just flash`).
flash:
    arm-none-eabi-objcopy -O binary build/Debug/main-g474.elf build/Debug/main-g474.bin
    ../tool/flash.py main-g474 build/Debug/main-g474.bin --address 0x08008000

# Package the Release firmware and bootloader as one .uf2: the BANDOLIBRE drive and the update tool over MIDI install the firmware, STM32 DFU mode both.
# Named after the release's major and minor version: build/Release/main-v1_2.uf2.
dfu: init_build_release build_release
    cd ../boot-g474 && just init_build_release build_release
    arm-none-eabi-objcopy -O binary ../boot-g474/build/Release/boot-g474.elf ../boot-g474/build/Release/boot-g474.bin
    arm-none-eabi-objcopy -O binary build/Release/main-g474.elf build/Release/main-g474.bin
    ../tool/uf2.py build/Release/main-g474.bin build/Release/main-{{uf2_version}}.uf2 --with-bootloader ../boot-g474/build/Release/boot-g474.bin

# Install bootloader + Release application over SWD. Once per board.
flash_release: init_build_release build_release
    cd ../boot-g474 && just flash
    arm-none-eabi-objcopy -O binary build/Release/main-g474.elf build/Release/main-g474.bin
    ../tool/flash.py main-g474 build/Release/main-g474.bin --address 0x08008000
