# Build and run checks for the web MIDI/config app. The app itself lives in
# docs/tools/ because the site publishes it from there (GitHub Pages ignores
# symlinks, so it cannot be a link). It is single-file with no build step of
# its own - this just catches JS syntax errors in midi.html's inline <script>
# blocks before they'd otherwise only surface in a browser console.
test:
    mkdir -p build
    bun build ../../docs/tools/midi.html --outdir build
