default:
    @just --list

# The release's major and minor version, for the .uf2 name: bandolibre-v1.2-alpha-… -> v1_2.
uf2_version := `git describe --tags --match 'bandolibre-v*' --abbrev=0 2>/dev/null | sed -nE 's/^bandolibre-v([0-9]+)\.([0-9]+).*/v\1_\2/p' | grep . || echo vunknown`

# Generate build system into build/Debug. Re-run after adding/removing source files or changing CMakeLists.txt.
init_build:
    cmake --preset Debug

build:
    cmake --build --preset Debug

# Generate build system into build/Release. Re-run after adding/removing source files or changing CMakeLists.txt.
init_build_release:
    cmake --preset Release

build_release:
    cmake --build --preset Release

# Install the bootloader at 0x08000000, leaving the application above it untouched.
flash: init_build_release build_release
    arm-none-eabi-objcopy -O binary build/Release/boot-g474.elf build/Release/boot-g474.bin
    ../tool/flash.py main-g474 build/Release/boot-g474.bin --address 0x08000000

# Package the Release bootloader alone as a .uf2 for the update tool, which installs it in STM32 DFU mode:
# build/Release/main-bootloader-v1_2.uf2. The release file from `just dfu` in ../main-g474 carries it too.
uf2: init_build_release build_release
    arm-none-eabi-objcopy -O binary build/Release/boot-g474.elf build/Release/boot-g474.bin
    ../tool/uf2.py --bootloader build/Release/boot-g474.bin build/Release/main-bootloader-{{uf2_version}}.uf2

# Report how much of the 32 KB bootloader region is used.
size: init_build_release build_release
    arm-none-eabi-size build/Release/boot-g474.elf

# Reset the board via STLink
reset:
    st-flash reset
